FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

RUN apt-get update && apt-get install -y \
    software-properties-common \
    git curl wget vim build-essential \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Python 3.12 설치 (distutils 제외)
RUN apt-get update && apt-get install -y \
    python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

# get-pip 직접 다운로드하여 pip 설치
RUN wget https://bootstrap.pypa.io/get-pip.py && \
    python3.12 get-pip.py && \
    rm get-pip.py
# pip 설치 (Python 3.12용)

# Python 3.12를 기본으로 설정
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

# uv 설치 (vLLM 권장)
RUN python3.12 -m pip install uv

# 작업 디렉토리 설정
WORKDIR /workspace

# vLLM 가상환경 생성 및 설치
RUN uv venv --python 3.12 --seed /workspace/vllm_env
ENV PATH="/workspace/vllm_env/bin:$PATH"
ENV VIRTUAL_ENV="/workspace/vllm_env"

# vLLM 설치 (gpt-oss 지원 버전)
RUN uv pip install --pre vllm==0.10.1+gptoss \
    --extra-index-url https://wheels.vllm.ai/gpt-oss/ \
    --extra-index-url https://download.pytorch.org/whl/nightly/cu128 \
    --index-strategy unsafe-best-match

# 추가 필수 패키지 설치
RUN uv pip install openai requests jupyter notebook

# 환경변수 설정
ENV PYTHONPATH=/workspace/scion_rag_challenge/src:/workspace
ENV CUDA_VISIBLE_DEVICES=0
ENV VLLM_USE_MODELSCOPE=false

# 포트 노출
EXPOSE 8000 8888

# 시작 스크립트
CMD ["bash"]
