# -----------------------------------------------------------------------------
# API keys / credentials
# -----------------------------------------------------------------------------
# Gemini (some modules read GOOGLE_API_KEY, others GEMINI_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OpenAI (ChatGPT keyword extraction backend)
OPENAI_API_KEY=

# PubMed
PUBMED_API_KEY=
PUBMED_EMAIL=

# -----------------------------------------------------------------------------
# vLLM defaults (for keyword extraction / answer generation)
# -----------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=openai/gpt-oss-20b

# -----------------------------------------------------------------------------
# Optional runtime defaults used by search settings
# -----------------------------------------------------------------------------
TARGET_DOCUMENTS=50
OUTPUT_DIRECTORY=outputs
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Credential file locations (file-based clients)
# -----------------------------------------------------------------------------
SCIENCEON_CREDENTIALS_PATH=configs/credentials/scienceon_api_credentials.json
PUBMED_CREDENTIALS_PATH=configs/credentials/pubmed_api_credentials.json

# -----------------------------------------------------------------------------
# ScienceON credential values (reference only)
# The current ScienceON client reads JSON file, not these env vars directly.
# Keep this block as single-source values if you manage credentials via env.
# -----------------------------------------------------------------------------
SCIENCEON_CLIENT_ID=
SCIENCEON_AUTH_KEY=
SCIENCEON_MAC_ADDRESS=
SCIENCEON_ACCESS_TOKEN=
SCIENCEON_REFRESH_TOKEN=
SCIENCEON_ACCESS_TOKEN_EXPIRE=
SCIENCEON_REFRESH_TOKEN_EXPIRE=
